# Notion integration token (https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Target Notion database id; the integration must be shared with the database
NOTION_DATABASE_ID=00000000000000000000000000000000

# Directory the watcher monitors for new audio files
AUDIO_DIR=./recordings

# Whisper model: tiny | base | small | medium | large
WHISPER_MODEL=base

# Optional: enables higher-quality 3-5 sentence summaries via OpenAI
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
